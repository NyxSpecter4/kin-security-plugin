{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kin.security.policy/v1",
  "title": "KIN Security Policy v1",
  "type": "object",
  "required": ["schema", "rules"],
  "properties": {
    "schema": { "const": "kin.security.policy/v1" },
    "name": { "type": "string" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["outcome"],
        "properties": {
          "severity": { "type": "array", "items": { "enum": ["critical", "high", "medium", "low"] } },
          "cwe": { "type": "array", "items": { "type": "string", "pattern": "^CWE-\\d+$" } },
          "outcome": { "enum": ["block", "warn", "pass"] }
        }
      }
    },
    "suppressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reason", "expires"],
        "properties": {
          "finding": { "type": "string", "description": "exact finding_id (fingerprint)" },
          "cwe": { "type": "string" },
          "file": { "type": "string" },
          "reason": { "type": "string" },
          "expires": { "type": "string", "format": "date-time", "description": "Expired suppressions are IGNORED, never applied." }
        }
      }
    }
  }
}
